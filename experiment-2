        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n",
        "\n",
        "# Target Variable\n",
        "y_name = input(\"Enter Target Variable Name: \")\n",
        "y = np.array(list(map(float, input(f\"Enter {y_name} values (comma separated): \").split(','))))\n",
        "\n",
        "# Number of Features\n",
        "n = int(input(\"Enter Number of Features: \"))\n",
        "\n",
        "data = {}\n",
        "feature_names = []\n",
        "\n",
        "for i in range(n):\n",
        "    name = input(f\"Enter Feature {i+1} Name: \")\n",
        "    feature_names.append(name)\n",
        "\n",
        "    values = np.array(list(map(float, input(f\"Enter {name} values: \").split(','))))\n",
        "\n",
        "    if len(values) != len(y):\n",
        "        print(\"Error: Number of values must be same.\")\n",
        "        exit()\n",
        "\n",
        "    data[name] = values\n",
        "\n",
        "X = pd.DataFrame(data)\n",
        "\n",
        "# Model Training\n",
        "model = LinearRegression()\n",
        "model.fit(X, y)\n",
        "\n",
        "pred = model.predict(X)\n",
        "\n",
        "# Metrics\n",
        "mse = mean_squared_error(y, pred)\n",
        "mae = mean_absolute_error(y, pred)\n",
        "rmse = np.sqrt(mse)\n",
        "r2 = r2_score(y, pred)\n",
        "\n",
        "# Regression Equation\n",
        "print(\"\\n------ Regression Equation ------\")\n",
        "equation = f\"{y_name} = {model.intercept_:.2f}\"\n",
        "\n",
        "for coef, name in zip(model.coef_, feature_names):\n",
        "    equation += f\" + ({coef:.2f})*{name}\"\n",
        "\n",
        "print(equation)\n",
        "\n",
        "print(\"\\nIntercept =\", round(model.intercept_,2))\n",
        "\n",
        "for coef, name in zip(model.coef_, feature_names):\n",
        "    print(f\"Coefficient of {name} =\", round(coef,2))\n",
        "\n",
        "print(\"\\nMSE  =\", round(mse,4))\n",
        "print(\"MAE  =\", round(mae,4))\n",
        "print(\"RMSE =\", round(rmse,4))\n",
        "print(\"R2 Score =\", round(r2,4))\n",
        "\n",
        "# Prediction\n",
        "choice = input(\"\\nDo you want Prediction? (yes/no): \").lower()\n",
        "\n",
        "if choice == \"yes\":\n",
        "    sample = []\n",
        "\n",
        "    for name in feature_names:\n",
        "        sample.append(float(input(f\"Enter {name}: \")))\n",
        "\n",
        "    sample_df = pd.DataFrame([sample], columns=feature_names)\n",
        "\n",
        "    result = model.predict(sample_df)\n",
        "\n",
        "    print(f\"\\nPredicted {y_name} =\", round(result[0],2))\n",
        "\n",
        "# Scatter Plot\n",
        "plt.figure(figsize=(6,5))\n",
        "plt.scatter(y, pred, color='blue')\n",
        "plt.plot([min(y), max(y)], [min(y), max(y)], 'r--')\n",
        "plt.xlabel(\"Actual Values\")\n",
        "plt.ylabel(\"Predicted Values\")\n",
        "plt.title(\"Actual vs Predicted\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# Performance Chart\n",
        "metrics = [\"R2\", \"RMSE\", \"MAE\", \"MSE\"]\n",
        "values = [r2, rmse, mae, mse]\n",
        "\n",
        "plt.figure(figsize=(6,4))\n",
        "bars = plt.bar(metrics, values)\n",
        "\n",
        "for bar in bars:\n",
        "    plt.text(bar.get_x()+0.15, bar.get_height(), round(bar.get_height(),2))\n",
        "\n",
        "plt.title(\"Linear Regression Performance\")\n",
        "plt.ylabel(\"Value\")\n",
        "plt.grid(axis=\"y\")\n",
        "plt.show()"
